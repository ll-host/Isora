pkgname=isora
pkgver=0.1.0_alpha2
pkgrel=1
pkgdesc='Local QEMU/KVM virtual machine manager for Arch Linux'
arch=('x86_64')
url='https://github.com/ll-host/Isora'
license=('GPL-3.0-only')
depends=('qt6-declarative' 'libvirt' 'qemu-desktop' 'virt-viewer')
makedepends=('cmake' 'ninja' 'pkgconf')
optdepends=('edk2-ovmf: UEFI firmware support')
options=('!debug')
install=isora.install
source=("Isora-${pkgver//_/-}.tar.gz::${url}/archive/refs/tags/v${pkgver//_/-}.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "Isora-${pkgver//_/-}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DISORA_DEPLOY_RUNTIME=OFF \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
