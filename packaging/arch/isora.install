post_install() {
  local sockets=(
    virtqemud.socket
    virtqemud-ro.socket
    virtstoraged.socket
    virtstoraged-ro.socket
  )

  if [[ -d /run/systemd/system ]]; then
    /usr/bin/systemctl enable --now "${sockets[@]}"
  else
    /usr/bin/systemctl enable "${sockets[@]}"
  fi
}

post_upgrade() {
  post_install
}
